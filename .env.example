# ==============================================================
# Document Q&A Assistant Configuration
# ==============================================================

# LLM Provider: "gemini", "openai", or "mock" (default: gemini)
LLM_PROVIDER=gemini

# API Keys (Nếu để trống, hệ thống sẽ chạy ở chế độ Local Mock Generator)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Retrieval Mode: "local" (in-process) or "grpc" (microservice)
RETRIEVAL_MODE=local

# gRPC Configuration
GRPC_HOST=localhost
GRPC_PORT=50051

# Vector Database (Qdrant)
# Để trống QDRANT_URL nếu muốn chạy chế độ Local Embedded Storage (lưu file trên máy)
# Hoặc điền URL và API Key nếu dùng Qdrant Cloud
QDRANT_PATH=data/qdrant_storage
QDRANT_COLLECTION=technical_documents
QDRANT_URL=
QDRANT_API_KEY=

# Local Embedding Model (SentenceTransformers, chạy offline trên máy)
EMBEDDING_MODEL=all-MiniLM-L6-v2

