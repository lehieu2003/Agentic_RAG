# ==============================================================
# Document Q&A Assistant Configuration
# ==============================================================

# LLM Provider: "gemini", "openai", or "mock" (default: gemini)
LLM_PROVIDER=gemini

# API Keys (Nếu để trống, hệ thống sẽ chạy ở chế độ Local Mock Generator)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Retrieval Mode: "local" (in-process) or "grpc" (microservice)
RETRIEVAL_MODE=local

# gRPC Configuration
GRPC_HOST=localhost
GRPC_PORT=50051

# Vector Database (Qdrant Cloud hoặc Local)
# Điền URL và API Key khi kết nối Qdrant Cloud Cluster
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=technical_documents
# (Tùy chọn) Đường dẫn lưu trữ khi chạy offline cục bộ không dùng Cloud
QDRANT_PATH=data/qdrant_storage

# Local Embedding Model (SentenceTransformers, chạy offline trên máy)
EMBEDDING_MODEL=all-MiniLM-L6-v2

