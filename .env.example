# ==============================================================
# Document Q&A Assistant Configuration
# ==============================================================

# LLM Provider: "gemini", "openai", or "mock" (default: gemini)
LLM_PROVIDER=gemini

# API Keys (Nếu để trống, hệ thống sẽ chạy ở chế độ Local Mock Generator)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Retrieval Mode: "local" (in-process) or "grpc" (microservice)
RETRIEVAL_MODE=local

# gRPC Configuration
GRPC_HOST=localhost
GRPC_PORT=50051

# Vector Database (Qdrant Cloud hoặc Local)
# Điền URL và API Key khi kết nối Qdrant Cloud Cluster
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=technical_documents
# (Tùy chọn) Đường dẫn lưu trữ khi chạy offline cục bộ không dùng Cloud
QDRANT_PATH=data/qdrant_storage

# Multilingual Embedding Model (Vietnamese + English, SentenceTransformers)
# Lưu ý: đổi model/chiều vector phải chạy: python scripts/reindex.py --recreate --yes
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
EMBEDDING_MAX_SEQ_LENGTH=512
EMBEDDING_BATCH_SIZE=32
# (Tùy chọn) "mps" trên Apple Silicon, "cuda" nếu có GPU; để trống = auto
EMBEDDING_DEVICE=

# Reranker đa ngữ (Vietnamese + English)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Token-aware chunking (chunk thực tế được giới hạn theo EMBEDDING_MAX_SEQ_LENGTH)
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# Số đoạn ngữ cảnh đưa vào LLM sau rerank (hệ thống tự dùng, UI không còn cho chỉnh)
RERANK_TOP_K=5

